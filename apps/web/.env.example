# ==============================================================================
# VeriCarbon Monorepo — Environment Variables Template (.env.example)
# Copy to .env (or apps/web/.env.local) and populate values.
# NEVER commit real private keys or production secrets to source control.
# ==============================================================================

# --- Blockchain / EVM Configuration ---
# Target Networks: Base Sepolia (chainId 84532) | Local Anvil (chainId 31337)
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545

# Deployer / Operator Private Key (throwaway development key only)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed Contract Addresses on Base Sepolia
NEXT_PUBLIC_VERICARBON_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CARBON_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_EZKL_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# --- Supabase Database, Auth & Edge Functions ---
# Local PGlite / Supabase Gateway: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=local-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-service-role
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_LOCAL_PORT=54321

# --- Decentralized Storage (IPFS / Pinata Free Tier) ---
PINATA_JWT=your-pinata-jwt-token-placeholder
PINATA_API_KEY=your-pinata-api-key-placeholder
PINATA_API_SECRET=your-pinata-api-secret-placeholder
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
NEXT_PUBLIC_PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# --- Earth Observation & Remote Sensing ---
# Microsoft Planetary Computer (Free public STAC catalog)
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
PLANETARY_COMPUTER_SUBSCRIPTION_KEY=optional-planetary-computer-key

# --- Vercel Cron Keep-Alive ---
CRON_SECRET=your-vercel-cron-secret-placeholder
