pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {stdJson} from "forge-std/StdJson.sol";
import {Halo2Verifier} from "../src/verifiers/Halo2Verifier.sol";

/// @title Halo2VerifierTest
/// @notice Foundry integration test for the ezkl-generated Halo2Verifier contract.
/// @dev Loads the fixture proof generated by `services/zk` (`zk prove`) and verifies:
///      1. Valid proof + public instances `[modelHash, dataCommitment, claimedAmount]` passes.
///      2. Tampered `claimedAmount` (`instances[2]`) reverts on-chain.
contract Halo2VerifierTest is Test {
    using stdJson for string;

    Halo2Verifier internal verifier;
    bytes internal fixtureProof;
    uint256[] internal fixtureInstances;

    function setUp() public {
        verifier = new Halo2Verifier();

        string memory root = vm.projectRoot();
        string memory path = string.concat(root, "/../../services/zk/artifacts/proof.json");
        string memory json = vm.readFile(path);

        fixtureProof = json.readBytes(".hex_proof");

        bytes32[] memory rawOutputs = json.readBytes32Array(".pretty_public_inputs.outputs[0]");
        require(rawOutputs.length == 3, "Expected 3 public instances: [modelHash, dataCommitment, claimedAmount]");

        fixtureInstances = new uint256[](3);
        fixtureInstances[0] = uint256(rawOutputs[0]); // modelHash
        fixtureInstances[1] = uint256(rawOutputs[1]); // dataCommitment
        fixtureInstances[2] = uint256(rawOutputs[2]); // claimedAmount
    }

    /// @notice Verifies that a valid ezkl proof generated from evidence_bundle.json passes on-chain verification.
    function test_VerifyProof_ValidFixturePasses() public {
        bool ok = verifier.verifyProof(fixtureProof, fixtureInstances);
        assertTrue(ok, "Valid ezkl Halo2 proof must verify");
    }

    /// @notice Verifies that tampering with the public `claimedAmount` instance (`instances[2]`) reverts.
    function test_VerifyProof_RevertWhen_TamperedClaimedAmount() public {
        uint256[] memory tamperedInstances = new uint256[](3);
        tamperedInstances[0] = fixtureInstances[0];
        tamperedInstances[1] = fixtureInstances[1];
        tamperedInstances[2] = fixtureInstances[2] + 1; // Inflate claimedAmount by +1 unit

        vm.expectRevert();
        verifier.verifyProof(fixtureProof, tamperedInstances);
    }
}
